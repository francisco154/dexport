<?xml version="1.0" encoding="utf-8"?>
<!--
  DexPort Agent — manifiesto (v3)
  ════════════════════════════════════════════════════════════
  App auxiliar del proyecto DexPort (web). v3 RECONSTRUIDA para no
  interferir jamás con el rendimiento del teléfono:

    · servicio de accesibilidad LIGERO (solo eventos de cambio de
      ventana, sin prefetch de nodos, sin getRoot)
    · TODO el trabajo pesado (enumerar apps, labels, íconos) pasa por
      UN solo hilo de fondo de baja prioridad — nunca el hilo principal
      ni los hilos del servidor TCP
    · lista COMPLETA de apps instaladas (QUERY_ALL_PACKAGES + <queries>;
      Android 11+ filtra los paquetes visibles si no se declaran)
    · espejo de notificaciones con snapshot VIVO en memoria (sin
      getActiveNotifications() en cada consulta)

  La web lo consulta vía adb.createSocket("tcp:8458").
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dexport.agent">

    <!-- ServerSocket localhost:8458 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- v3: lista COMPLETA de apps. App sideloaded por ADB (no Play
         Store): el permiso QUERY_ALL_PACKAGES está permitido para uso
         propio/dispositivo personal, que es exactamente este caso. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- v3: visibilidad total de apps lanzables (redundante con lo de
         arriba, pero explícito para queryIntentActivities en 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- v2+: espejo de notificaciones (se activa por ADB con
             `cmd notification allow_listener com.dexport.agent/.AgentNotificationListener`) -->
        <service
            android:name=".AgentNotificationListener"
            android:exported="false"
            android:label="@string/notif_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
