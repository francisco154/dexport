<?xml version="1.0" encoding="utf-8"?>
<!--
  DexPort Agent — manifiesto (v5)
  ════════════════════════════════════════════════════════════
  App auxiliar del proyecto DexPort (web). v5 — ARQUITECTURA
  «PAQUETE ÚNICO + HIBERNACIÓN»:

    · SIN servicio de accesibilidad (eliminado para siempre):
      ya no toca el foco, el táctil ni la multitarea del teléfono.
      Toda la detección de apps abiertas y la navegación las hace
      la web por ADB shell (dumpsys / input keyevent).
    · El puente TCP 127.0.0.1:8458 vive en un servicio EN PRIMER
      PLANO (AgentServerService) que DexPort enciende/apaga POR
      ADB. Sin requests 90 s (o tras entregar el paquete) →
      HIBERNA: servidor apagado, notificación fuera, cero consumo.
    · Una ÚNICA solicitud `package.get` entrega apps + TODOS los
      íconos + launcher; luego la web manda `agent.hibernate`.
    · El espejo de notificaciones (NotificationListenerService)
      sigue pasivo: el sistema lo empuja, cero costo en reposo.

  La web lo consulta vía adb.createSocket("tcp:8458").
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dexport.agent">

    <!-- ServerSocket localhost:8458 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- lista COMPLETA de apps. App sideloaded por ADB (no Play
         Store): el permiso QUERY_ALL_PACKAGES está permitido para uso
         propio/dispositivo personal, que es exactamente este caso. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- v5: servicio en primer plano que aloja el puente (se apaga
         solo al hibernar — consumo real solo mientras sirve el
         paquete a la web) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- visibilidad total de apps lanzables (redundante con lo de
         arriba, pero explícito para queryIntentActivities en 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v5: PUENTE — servicio en primer plano (specialUse en API
             34+). Lo arranca DexPort por ADB con
             `am start-foreground-service -n com.dexport.agent/.AgentServerService`
             y muere solo (hibernación) tras 90 s ocioso o cuando la
             web confirma la recepción del paquete. Sin intent-filter:
             solo intents explícitos. -->
        <service
            android:name=".AgentServerService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Puente USB local 127.0.0.1 para DexPort (paquete de apps/íconos, se hiberna solo)" />
        </service>

        <!-- espejo de notificaciones (se activa por ADB con
             `cmd notification allow_listener com.dexport.agent/.AgentNotificationListener`) -->
        <service
            android:name=".AgentNotificationListener"
            android:exported="false"
            android:label="@string/notif_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
